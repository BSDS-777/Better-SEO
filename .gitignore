# ============================================================
# Better SEO — .gitignore
# WordPress Plugin | PHP 8.3 | Node.js | Composer
# ============================================================


# ─── COMPOSER ───────────────────────────────────────────────
vendor/
composer.lock


# ─── NODE / NPM ─────────────────────────────────────────────
node_modules/
npm-debug.log
npm-debug.log.*
yarn-debug.log
yarn-error.log
package-lock.json
yarn.lock
.pnpm-debug.log


# ─── BUILD ARTIFACTS ────────────────────────────────────────
# Minified assets (generated at build time — not committed)
lib/js/*.min.js
lib/js/*.min.js.map
lib/css/*.min.css
lib/css/*.min.css.map

# Source maps
*.map

# Build output directories
build/
dist/


# ─── WORDPRESS SPECIFIC ─────────────────────────────────────
# Never commit WordPress core files
wp-admin/
wp-includes/
wp-content/uploads/
wp-content/upgrade/
wp-content/backup-db/
wp-content/cache/
wp-content/blogs.dir/
wp-content/advanced-cache.php
wp-content/wp-cache-config.php
wp-content/object-cache.php
wp-content/db.php

# WordPress config (contains DB credentials)
wp-config.php
wp-config-local.php
wp-config-dev.php
wp-config-staging.php

# WordPress debug log
wp-content/debug.log
debug.log

# WordPress auto-generated files
.htaccess
sitemap.xml
sitemap_index.xml


# ─── PLUGIN SENSITIVE FILES ─────────────────────────────────
# Local config overrides (copy from config.sample.php)
config/config.php
config/local.php
config/*.local.php

# API keys, credentials, secrets
.env
.env.*
!.env.example
secrets.php
credentials.php


# ─── PHP ────────────────────────────────────────────────────
# PHPUnit cache and coverage
.phpunit.cache/
.phpunit.result.cache
phpunit.xml
!phpunit.xml.dist
coverage/
coverage.xml
clover.xml

# PHP CS Fixer cache
.php-cs-fixer.cache
.php_cs.cache

# PHPCS cache
.phpcs-cache

# Psalm cache
.psalm/


# ─── TESTING ────────────────────────────────────────────────
tests/bootstrap.php
tests/_output/
tests/_support/_generated/
.codeception/


# ─── IDE / EDITOR ───────────────────────────────────────────
# JetBrains (PhpStorm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr

# Visual Studio Code
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Neovim
*.swp
*.swo
*~
.netrwhist

# Emacs
*#
.#*
\#*#


# ─── OPERATING SYSTEM ───────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*


# ─── LOGS & TEMP ────────────────────────────────────────────
*.log
*.logs
logs/
tmp/
temp/
.tmp/
.cache/


# ─── DEPLOYMENT ─────────────────────────────────────────────
# Deployment scripts with credentials
deploy.php
deploy-config.php
.deployignore
.ftpconfig
.ftppass
sftp-config.json
rsync-exclude.txt

# Release zip (generated by build script)
*.zip
!tests/fixtures/*.zip


# ─── DOCUMENTATION BUILD ────────────────────────────────────
docs/_build/
docs/api/
phpdoc/
phpdoc.xml
!phpdoc.xml.dist


# ─── MISCELLANEOUS ──────────────────────────────────────────
# Backup files
*.bak
*.backup
*.orig
*.save

# Patch files
*.patch
*.diff

# Archive files (except test fixtures)
*.tar
*.tar.gz
*.tgz
*.rar

# Internal scratch notes (never deliverables)
*-analysis.md
*-scratch.md
*-notes.md
*-todo-local.md